#!/bin/sh
# repo guard - primary worktree commit guard
#
# The rule and the reasoning live in the JJ Company charter:
#   C:\Users\ojaej\orca\jj-company\CLAUDE.md   section 3
# That section names this repo as a SHARED clone: branch it with `git worktree`,
# never with `checkout -b`.
#
# ASCII-only on purpose: hook output goes through whatever client invoked git
# (Git Bash, PowerShell, an IDE). Korean here can arrive mangled in exactly the
# moment the message matters.
#
# WHY
#   HEAD is a shared resource. On 2026-08-15 a parallel session moved HEAD off
#   the branch another session was on, and that session's commit landed on the
#   wrong branch. Nothing errored. It was found by reading the reflog afterwards.
#
#   So the primary working tree is pinned to main and never receives commits.
#   All work happens in linked worktrees, where HEAD is private to that worktree.
#
# WHAT IT DOES
#   Refuses any commit made from the PRIMARY worktree. Linked worktrees pass.
#   Detection: `git rev-parse --git-dir` returns a path under .git/worktrees/
#   for a linked worktree, and plain `.git` for the primary one.
#
# INSTALL (per clone, once)
#   git config core.hooksPath scripts/githooks
#   Verify with: powershell -File scripts\check-repo-guard.ps1

git_dir=$(git rev-parse --git-dir 2>/dev/null) || exit 0

case "$git_dir" in
    */worktrees/*)
        # Linked worktree: commits are allowed. Run the data-invariant checks that
        # guard what is in this commit, before it lands.
        #
        # WHY (2026-08-27): scenes.self_test() existed and passed nobody for ten days.
        # In that gap two keyword shadows appeared (ep33 free-lane, ep34 blueprint) and
        # both silently returned the wrong scene. A check with no automatic caller is a
        # note, not a check. scenes.py now also self-checks at runtime; this is the
        # second layer, so a bad table cannot even be committed.
        staged=$(git diff --cached --name-only 2>/dev/null)
        rc=0
        case "$staged" in
            *cards/scenes.py*)
                if out=$(py cards/scenes.py 2>&1); then
                    printf '  [repo-guard] scenes self_test OK\n' >&2
                else
                    printf '\n  [repo-guard] scenes self_test FAILED - commit refused\n\n%s\n\n' "$out" >&2
                    rc=1
                fi
                ;;
        esac
        case "$staged" in
            *cards/freshness.py*)
                if out=$(py cards/freshness.py 2>&1); then
                    printf '  [repo-guard] freshness self_test OK\n' >&2
                else
                    printf '\n  [repo-guard] freshness self_test FAILED - commit refused\n\n%s\n\n' "$out" >&2
                    rc=1
                fi
                ;;
        esac
        exit $rc
        ;;
esac

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')

cat >&2 <<EOF

  [repo-guard] commit refused: this is the PRIMARY worktree (branch: $branch)

  Charter section 3: the primary tree stays on main and takes no commits.
  Work in a linked worktree instead - HEAD there is private to that worktree,
  so a parallel session cannot move it out from under you.

      git worktree add ../.wt/<name> -b <branch> origin/main
      cd ../.wt/<name>
      ...work, commit, push, open PR...
      git worktree remove ../.wt/<name>
      git fetch origin

  ALREADY HAVE UNCOMMITTED WORK HERE? Move it, do not redo it. The stash is
  shared across worktrees, so this loses nothing:

      git stash push -u -m "move to worktree"
      git worktree add ../.wt/<name> -b <branch> origin/main
      cd ../.wt/<name>
      git stash pop

  CAUTION: gitignored files are NOT taken by "git stash -u". They stay behind
  in this tree, and the move looks complete because git status is clean. List
  them BEFORE you stash, and move them by hand afterwards:

      git status --porcelain --ignored | grep '^!!'

  Verify each copy (compare size and checksum) before deleting the original.
  Do not reach for "git stash -a" instead - that also drags logs/, reports/
  and .omc/ out of this tree.

  Reason this exists: 2026-08-15, twice. The second time happened while fixing
  the first. A commit silently landed on another session's branch.
  The stash caveat is from the same day: a 1.1MB codex session log was ignored
  by .gitignore, so "stash -u" left it behind while reporting success.

EOF

exit 1
